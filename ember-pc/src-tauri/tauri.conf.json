{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "0.5.19",
  "identifier": "org.lucamedia.ember.pc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ember",
        "width": 1440,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mpv/*": "mpv/",
      "resources/ember.lua": "ember.lua",
      "resources/ember_osc.lua": "ember_osc.lua",
      "resources/mpv-config/mpv.conf": "mpv-config/mpv.conf",
      "resources/mpv-config/script-opts/modernz.conf": "mpv-config/script-opts/modernz.conf",
      "resources/mpv-config/scripts/modernz.lua": "mpv-config/scripts/modernz.lua",
      "resources/mpv-config/fonts/*": "mpv-config/fonts/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}