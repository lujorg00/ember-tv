{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "0.1.5",
  "identifier": "org.lucamedia.ember.pc",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Ember", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "resources/mpv/*": "mpv/", "resources/ember.lua": "ember.lua" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
